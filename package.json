{
  "name": "zuu",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build:client": "pnpm --filter @zuu/client build",
    "build:web": "pnpm --filter web build",
    "dev": "pnpm build:client && node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev:web": "pnpm --filter web dev -- --host 127.0.0.1",
    "start": "pnpm build:client && node --env-file-if-exists=.env --import tsx src/index.ts",
    "check": "pnpm build:client && node --env-file-if-exists=.env --import tsx scripts/check.ts && node --import tsx scripts/check-client-release.ts",
    "client:release:check": "pnpm build:client && node --import tsx scripts/check-client-release.ts",
    "client:release:prepare": "node --import tsx scripts/prepare-client-release.ts",
    "check:pi-workflow": "pnpm build:client && node --env-file-if-exists=.env --import tsx scripts/check-pi-workflow-runtime.ts",
    "example:client": "pnpm build:client && node --env-file-if-exists=.env --import tsx examples/client-basic.ts",
    "example:pi-sdk": "node --env-file-if-exists=.env --import tsx examples/pi-sdk-basic.ts",
    "typecheck": "pnpm build:client && tsc --noEmit"
  },
  "dependencies": {
    "@zuu/client": "workspace:*",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@hono/node-server": "^1.19.7",
    "hono": "^4.13.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
