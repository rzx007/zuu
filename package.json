{
  "name": "zuu",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build:web": "pnpm --filter web build",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev:web": "pnpm --filter web dev -- --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "check": "node --env-file-if-exists=.env --import tsx scripts/check.ts",
    "check:pi-workflow": "node --env-file-if-exists=.env --import tsx scripts/check-pi-workflow-runtime.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zuu/client": "workspace:*",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@hono/node-server": "^1.19.7",
    "hono": "^4.13.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
